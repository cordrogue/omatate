# --- Omarchy theme resolution -------------------------------------------------
#
# Palette, font family and base size come from the live Omarchy theme. Every
# lookup is best-effort: anything missing falls back to the hard-coded Gand
# values below and logs a single stderr warning.

FALLBACK_PALETTE = {
    "background": "#3a332a",
    "dark_background": "#2e2820",
    "darker_background": "#241f19",
    "lighter_background": "#463e33",
    "foreground": "#f5ecd9",
    "dark_foreground": "#b0a48f",
    "muted": "#968872",
    "accent": "#d6a06b",
    "selection": "#514838",
    "red": "#ed806b",
    "yellow": "#dab46b",
    "green": "#83baa1",
    "blue": "#74accf",
}
FALLBACK_FONT = "JetBrainsMono Nerd Font"
FALLBACK_BASE_SIZE = 11


def _omarchy(*args):
    try:
        result = subprocess.run(
            ["omarchy", *args],
            capture_output=True,
            text=True,
            timeout=2,
        )
    except (OSError, subprocess.SubprocessError) as error:
        warn(f"cannot run omarchy {' '.join(args)}: {error}")
        return None
    if result.returncode != 0:
        return None
    value = result.stdout.strip()
    return value or None


def theme_slug(name=None):
    if name is None:
        name = _omarchy("theme", "current")
    if not name:
        return None
    return name.strip().lower().replace(" ", "-")


def _colors_path(name, slug):
    candidates = [
        os.path.expanduser(f"~/.config/omarchy/themes/{slug}/colors.toml"),
        f"/usr/share/omarchy/themes/{slug}/colors.toml",
    ]
    directory = _omarchy("theme", "dir", name)
    if directory:
        candidates.append(os.path.join(directory, "colors.toml"))
    for candidate in candidates:
        if os.path.isfile(candidate):
            return candidate
    return None


def _is_color(value):
    if not isinstance(value, str):
        return False
    text = value.strip()
    if not text.startswith("#") or len(text) not in (4, 7, 9):
        return False
    return all(character in "0123456789abcdefABCDEF" for character in text[1:])


def resolve_palette():
    palette = dict(FALLBACK_PALETTE)
    name = _omarchy("theme", "current")
    if not name:
        warn("omarchy theme unknown; using built-in Gand palette")
        return palette
    slug = theme_slug(name)
    path = _colors_path(name, slug)
    if not path:
        warn(f"no colors.toml for theme {slug!r}; using built-in Gand palette")
        return palette
    try:
        with open(path, "rb") as handle:
            data = tomllib.load(handle)
    except (OSError, tomllib.TOMLDecodeError, ValueError) as error:
        warn(f"cannot parse {path}: {error}; using built-in Gand palette")
        return palette
    for key in FALLBACK_PALETTE:
        value = data.get(key)
        if _is_color(value):
            palette[key] = value.strip()
    return palette


def resolve_font():
    family = _omarchy("font", "current") or FALLBACK_FONT
    size = FALLBACK_BASE_SIZE
    path = os.path.expanduser("~/.config/omarchy/shell.toml")
    try:
        with open(path, "rb") as handle:
            data = tomllib.load(handle)
        candidate = data.get("font", {}).get("base-size")
        if isinstance(candidate, bool) or not isinstance(candidate, (int, float)):
            raise ValueError("base-size is not a number")
        if not 6 <= float(candidate) <= 40:
            raise ValueError(f"base-size {candidate} out of range")
        size = float(candidate)
    except FileNotFoundError:
        pass
    except (OSError, tomllib.TOMLDecodeError, ValueError, AttributeError) as error:
        warn(f"cannot read font base-size from {path}: {error}; using {size}")
    return family, size


def resolve_theme():
    palette = resolve_palette()
    family, size = resolve_font()
    return {"palette": palette, "font_family": family, "font_size": size}


def rgba(color, alpha=1.0):
    text = color.strip().lstrip("#")
    if len(text) == 3:
        text = "".join(character * 2 for character in text)
    text = text[:6].ljust(6, "0")
    red = int(text[0:2], 16)
    green = int(text[2:4], 16)
    blue = int(text[4:6], 16)
    if alpha >= 1.0:
        return f"rgb({red}, {green}, {blue})"
    return f"rgba({red}, {green}, {blue}, {alpha:g})"


def build_css(theme):
    colors = theme["palette"]
    family = theme["font_family"].replace('"', "")
    size = theme["font_size"]
    size_text = f"{size:g}pt"

    background = colors["background"]
    lighter = colors["lighter_background"]
    darker = colors["darker_background"]
    foreground = colors["foreground"]
    muted = colors["muted"]
    accent = colors["accent"]

    hairline = rgba(foreground, 0.25)
    small_text = f"{size * 0.82:g}pt"

    return f"""
.panel, .panel * {{
  font-family: "{family}", monospace;
  font-size: {size_text};
}}
.panel {{
  background-color: {rgba(background, 1.0)};
  border: 1px solid {hairline};
  border-radius: 0;
  color: {foreground};
  padding: 6px;
}}
.panel-header {{
  min-height: 22px;
  padding: 0;
}}
.entry-card {{
  background-color: {lighter};
  border: 1px solid {hairline};
  border-left: 2px solid {muted};
  border-radius: 0;
  padding: 5px;
}}
.entry-card.status-recording {{ border-left-color: {colors["red"]}; }}
.entry-card.status-transcribing {{ border-left-color: {colors["yellow"]}; }}
.entry-card.status-analyzing {{ border-left-color: {colors["yellow"]}; }}
.entry-card.status-done {{ border-left-color: {colors["green"]}; }}
.entry-card.status-no-transcript {{ border-left-color: {muted}; }}
.entry-card.status-context-error {{ border-left-color: {colors["red"]}; }}
.context-title {{
  color: {muted};
  font-size: {small_text};
}}
.section-row {{
  border-bottom: 1px solid {hairline};
  padding: 2px 0;
}}
.section-title {{
  background-color: transparent;
  background-image: none;
  border: 1px solid transparent;
  border-radius: 0;
  box-shadow: none;
  caret-color: {accent};
  color: {foreground};
  min-height: 20px;
  outline: none;
  padding: 0 2px;
}}
.section-title > text {{
  background-color: transparent;
  color: {foreground};
}}
.section-title > text selection {{
  background-color: {colors["selection"]};
  color: {foreground};
}}
.section-title:focus, .section-title:focus-within {{
  border-color: {accent};
}}
.section-delete {{
  border-color: transparent;
  min-height: 18px;
  min-width: 18px;
  padding: 0 2px;
}}
.section-delete:hover {{
  border-color: {hairline};
}}
.section-delete.hover-hidden {{
  opacity: 0;
}}
.transcript-editor {{
  background-color: {darker};
  border: 1px solid transparent;
  border-radius: 0;
  color: {foreground};
  padding: 3px;
  caret-color: {accent};
}}
.transcript-placeholder {{
  color: {muted};
  padding: 4px;
}}
.transcript-editor text {{
  background-color: transparent;
  color: {foreground};
}}
.transcript-editor text selection {{
  background-color: {colors["selection"]};
  color: {foreground};
}}
.transcript-editor:focus-within {{
  border-color: {accent};
}}
.empty-state {{
  color: {muted};
  padding: 4px 0;
}}
button {{
  background-image: none;
  background-color: transparent;
  border: 1px solid {hairline};
  border-radius: 0;
  box-shadow: none;
  color: {muted};
  min-height: 22px;
