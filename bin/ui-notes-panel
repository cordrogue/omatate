    # gi loads libwayland-client before gtk4-layer-shell can hook it; preload and re-exec.
    os.environ["LD_PRELOAD"] = (os.environ.get("LD_PRELOAD", "") + " " + _LAYER_SHELL).strip()
    os.execv(sys.executable, [sys.executable] + sys.argv)

